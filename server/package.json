{
  "name": "@fooddesk/server",
  "private": true,
  "version": "0.2.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --ignore '../node_modules/**' --ignore 'node_modules/**' src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
