# FoodDesk configuration — copy to /etc/fooddesk/env and adjust.

DATABASE_FILE=/var/lib/fooddesk/fooddesk.db
PORT=3000
HOST=127.0.0.1

# CUPS queue for the kitchen printer. List queues with: lpstat -p
# Leave commented out to print kitchen tickets from the browser instead.
#KITCHEN_PRINTER=kitchen

# Shown as the header on customer receipts.
RESTAURANT_NAME=FoodDesk

# it (default) or en — language of the printed receipts and tickets.
PDF_LANG=it

#CURRENCY_SYMBOL=€

# Orders before this hour belong to the previous service day.
SERVICE_DAY_CUTOFF_HOUR=5

# Backup tuning (used by fooddesk-backup.sh)
BACKUP_DIR=/var/backups/fooddesk
BACKUP_KEEP_DAYS=14
