# FoodDesk configuration — copy to /etc/fooddesk/env and adjust.

DATABASE_FILE=/var/lib/fooddesk/fooddesk.db
PORT=3000
HOST=127.0.0.1

# CUPS queue for the kitchen printer. List queues with: lpstat -p
# Leave commented out to print kitchen tickets from the browser instead.
#KITCHEN_PRINTER=kitchen

# Shown as the header on customer receipts.
RESTAURANT_NAME=FoodDesk

# Language of the printed receipts and tickets: it (default), en, es, fr, pt.
PDF_LANG=it

#CURRENCY_SYMBOL=€

# Orders before this hour belong to the previous service day.
SERVICE_DAY_CUTOFF_HOUR=5

# ---- customer self-ordering (switch it on in Settings, not here) ----
# Open customer orders allowed at once, and how long an unpaid counter order
# keeps its reserved portions before it expires and restocks.
#CUSTOMER_ORDER_CAP=30
#COUNTER_ORDER_TTL_MIN=30

# ---- online payments ----
# Keys live ONLY here, never in the database (which is copied to backup
# sticks). Leave unset to offer paying at the counter alone.
#STRIPE_SECRET_KEY=sk_live_...
#PAYPAL_CLIENT_ID=
#PAYPAL_CLIENT_SECRET=
#PAYPAL_ENV=live
#STRIPE_CURRENCY=eur
#PAYPAL_CURRENCY=EUR
# Where customers return after paying, when a real domain sits in front.
#PUBLIC_BASE_URL=https://ordini.example.com

# Backup tuning (used by fooddesk-backup.sh)
BACKUP_DIR=/var/backups/fooddesk
BACKUP_KEEP_DAYS=14
